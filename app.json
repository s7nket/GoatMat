{
  "expo": {
    "name": "GoatMat",
    "slug": "GoatMat",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goatmat",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.goatmat.app"
    },
    "android": {
      "package": "com.goatmat.app",
      "adaptiveIcon": {
        "backgroundColor": "#065C35",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A3D26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc9985e2-6d4d-4201-90fb-535c59a3d3b2"
      }
    },
    "owner": "s7nkets-team",
    "updates": {
      "url": "https://u.expo.dev/fc9985e2-6d4d-4201-90fb-535c59a3d3b2"
    }
  }
}
