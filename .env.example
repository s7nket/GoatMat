# Copy this file to `.env` and fill in the two values from
# Supabase Studio > Project Settings > Data API.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time. That is
# fine here: the anon key is meant to be public. Row Level Security protects the
# data. Never put the service_role key in any EXPO_PUBLIC_ variable.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
